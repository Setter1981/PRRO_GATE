+    .await
+    .expect("seed OP-A");
+    ops_repo::insert(
+        app.db_secure(),
+        &new_op("OP-B", "4000000002", "/tmp/b.dat", b"sb"),
+    )
+    .await
+    .expect("seed OP-B");
+    node_state::upsert_initial(app.db(), "4000000001", NodeMode::GoingOnline, ShiftState::Closed, 1)
+        .await
