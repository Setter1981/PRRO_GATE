{% extends "_base.html.j2" %}
{% block title %}Додати ФН — Налаштування{% endblock %}
{% block content %}
<h1>Налаштування</h1>
{% include "_settings_tabs.html.j2" %}

<h2>Додати фіскальний номер</h2>

{% if errors %}
<div class="alert-error">
  <strong>Помилки:</strong>
  <ul>
    {% for err in errors %}<li>{{ err }}</li>{% endfor %}
  </ul>
</div>
{% endif %}

<p>
  <button type="button" id="key_dialog_open_btn" class="btn-add">🔑 Обрати ключ</button>
  <span class="muted">Пре-заповнити ЄДРПОУ, назву організації та ІНН касира з сертифіката.</span>
</p>

<dialog id="key_import_dialog">
  <h2>🔑 Імпорт з ключа</h2>
  <p class="muted">
    Файл .jks / .pfx / .zs2 / .dat і пароль до нього. Поля основної форми
    заповняться автоматично значеннями з сертифіката.
  </p>
  <form method="dialog" id="key_dialog_form">
    <label>
      Файл ключа
      <input type="file" id="import_key_file"
             accept=".jks,.pfx,.p12,.zs2,.dat,.pk8">
    </label>
    <label>
      Пароль до ключа
      <input type="password" id="import_key_password" autocomplete="new-password">
    </label>
    <p><span id="import_key_status" class="muted"></span></p>
    <div class="form-actions">
      <button type="button" id="import_key_btn">Прочитати ключ</button>
      <button type="submit" id="key_dialog_cancel_btn"
              class="btn-cancel" formmethod="dialog"
              value="cancel">Скасувати</button>
    </div>
  </form>
</dialog>

<form method="post" action="/admin/ui/settings/fns/new" autocomplete="off">
  <input type="hidden" name="csrf_token" value="{{ csrf_token }}">

  <fieldset>
    <legend>Організація</legend>
    <label>
      ФН (10 цифр)
      <input type="text" name="fiscal_number" maxlength="10" pattern="[0-9]{10}"
             required value="{{ form.fiscal_number | default('') }}">
    </label>
    <label>
      ЄДРПОУ / ІПН
      <input type="text" name="tax_number" maxlength="10" pattern="[0-9]{8,10}"
             required value="{{ form.tax_number | default('') }}">
    </label>
    <label>
      Назва організації
      <input type="text" name="org_name" maxlength="256"
             value="{{ form.org_name | default('') }}">
    </label>
    <label>
      Назва торгової точки
      <input type="text" name="point_name" maxlength="256"
             value="{{ form.point_name | default('') }}">
    </label>
    <label>
      Адреса торгової точки
      <input type="text" name="point_address" maxlength="256"
             value="{{ form.point_address | default('') }}">
    </label>
    <label>
      Режим
      <select name="fiscal_mode" required>
        <option value="test" {% if form.fiscal_mode == "test" or not form.fiscal_mode %}selected{% endif %}>test</option>
        <option value="prod" {% if form.fiscal_mode == "prod" %}selected{% endif %}>prod</option>
      </select>
    </label>
    <label>
      TSP
      <select name="tsp_enabled">
        <option value="0" {% if form.tsp_enabled != "1" %}selected{% endif %}>Ні</option>
        <option value="1" {% if form.tsp_enabled == "1" %}selected{% endif %}>Так</option>
      </select>
    </label>
    <label>
      Offline дозволений
      <select name="offline_enabled">
        <option value="1" {% if form.offline_enabled != "0" %}selected{% endif %}>Так</option>
        <option value="0" {% if form.offline_enabled == "0" %}selected{% endif %}>Ні</option>
      </select>
    </label>
    <label>
      Offline коди (min)
      <input type="number" name="min_offline_codes" min="0"
             value="{{ form.min_offline_codes | default('0') }}">
    </label>
    <label>
      Offline коди (max)
      <input type="number" name="max_offline_codes" min="0"
             value="{{ form.max_offline_codes | default('0') }}">
    </label>
  </fieldset>

  <fieldset>
    <legend>Перший касир (опціонально)</legend>
    <p class="muted">Залишити порожнім, якщо касири додаватимуться пізніше.</p>
    <label>
      ПІБ касира
      <input type="text" name="operator_name" maxlength="256"
             value="{{ form.operator_name | default('') }}">
    </label>
    <label>
      ІНН касира (10 цифр)
      <input type="text" name="operator_inn" maxlength="10" pattern="[0-9]{10}"
             value="{{ form.operator_inn | default('') }}">
    </label>
    <label>
      Шлях до ключа (.jks / .dat / .pfx / .zs2)
      <input type="text" name="jks_path" maxlength="512"
             value="{{ form.jks_path | default('') }}">
    </label>
    <label>
      Пароль ключа
      <input type="password" name="jks_password" autocomplete="new-password">
    </label>
  </fieldset>

  <div class="form-actions">
    <button type="submit">Зберегти</button>
    <a class="btn-cancel" href="/admin/ui/settings/fns">Скасувати</a>
  </div>
</form>

<script>
(function () {
  const dialog = document.getElementById("key_import_dialog");
  const openBtn = document.getElementById("key_dialog_open_btn");
  const parseBtn = document.getElementById("import_key_btn");
  const statusEl = document.getElementById("import_key_status");
  if (!dialog || !openBtn || !parseBtn || !statusEl) return;

  openBtn.addEventListener("click", () => {
    statusEl.textContent = "";
    if (typeof dialog.showModal === "function") {
      dialog.showModal();
    } else {
      // Browser has no modal <dialog> support — refuse rather than
      // render inline (no backdrop/focus-trap = user could interact
      // with the form beneath while thinking the dialog is modal).
      alert("Ваш браузер не підтримує модальний діалог. " +
            "Оновіть до актуальної версії Chrome / Edge / Firefox.");
    }
  });

  // Read CSRF once from the main form's hidden input — avoids quoting
  // issues if the token generator ever emits `"` / `\` and eliminates
  // the server-side interpolation surface inside JS.
  const mainForm = document.querySelector(
    "form[action='/admin/ui/settings/fns/new']"
  );
  const csrfValue = mainForm
    ? (mainForm.elements["csrf_token"] || {}).value || ""
    : "";

  parseBtn.addEventListener("click", async () => {
    const fileEl = document.getElementById("import_key_file");
    const pwEl = document.getElementById("import_key_password");
    if (!fileEl.files || fileEl.files.length === 0) {
      statusEl.textContent = "Оберіть файл ключа.";
      return;
    }
    const fd = new FormData();
    fd.append("csrf_token", csrfValue);
    fd.append("password", pwEl.value || "");
    fd.append("key_file", fileEl.files[0]);
    statusEl.textContent = "Читаю ключ…";
    parseBtn.disabled = true;
    let success = false;
    try {
      const resp = await fetch("/admin/ui/settings/fns/parse-key", {
        method: "POST", body: fd,
      });
      const data = await resp.json();
      if (!resp.ok) {
        statusEl.textContent = data.error || "Помилка імпорту.";
        return;
      }
      if (data.edrpou) mainForm.elements["tax_number"].value = data.edrpou;
      if (data.org_name) mainForm.elements["org_name"].value = data.org_name;
      if (data.operator_name) mainForm.elements["operator_name"].value = data.operator_name;
      if (data.drfo) mainForm.elements["operator_inn"].value = data.drfo;
      success = true;
    } catch (e) {
      statusEl.textContent = "Мережева помилка. Спробуйте ще раз.";
    } finally {
      // Always wipe the password input — cleartext must not linger
      // after the request regardless of success or failure.
      if (pwEl) pwEl.value = "";
      parseBtn.disabled = false;
      if (success) dialog.close();
    }
  });

  // Defensive: wipe password on dialog close (ESC / Cancel / backdrop).
  dialog.addEventListener("close", () => {
    const pwEl = document.getElementById("import_key_password");
    if (pwEl) pwEl.value = "";
  });
})();
</script>
{% endblock %}
