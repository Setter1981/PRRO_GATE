{% extends "_base.html.j2" %}
{% block title %}Додати ФН — Налаштування{% endblock %}
{% block content %}
<h1>Налаштування</h1>
{% include "_settings_tabs.html.j2" %}

<h2>Додати фіскальний номер</h2>

{% if errors %}
<div class="alert-error">
  <strong>Помилки:</strong>
  <ul>
    {% for err in errors %}<li>{{ err }}</li>{% endfor %}
  </ul>
</div>
{% endif %}

<fieldset>
  <legend>🔑 Імпорт з ключа (опціонально)</legend>
  <p class="muted">
    Оберіть файл ключа (.jks / .pfx / .zs2 / .dat), введіть пароль — поля ЄДРПОУ,
    назва організації та ІНН касира заповняться автоматично.
  </p>
  <label>
    Файл ключа
    <input type="file" id="import_key_file"
           accept=".jks,.pfx,.p12,.zs2,.dat,.pk8">
  </label>
  <label>
    Пароль до ключа
    <input type="password" id="import_key_password" autocomplete="new-password">
  </label>
  <div class="form-actions">
    <button type="button" id="import_key_btn">Імпорт з ключа</button>
    <span id="import_key_status" class="muted"></span>
  </div>
</fieldset>

<form method="post" action="/admin/ui/settings/fns/new" autocomplete="off">
  <input type="hidden" name="csrf_token" value="{{ csrf_token }}">

  <fieldset>
    <legend>Організація</legend>
    <label>
      ФН (10 цифр)
      <input type="text" name="fiscal_number" maxlength="10" pattern="[0-9]{10}"
             required value="{{ form.fiscal_number | default('') }}">
    </label>
    <label>
      ЄДРПОУ / ІПН
      <input type="text" name="tax_number" maxlength="10" pattern="[0-9]{8,10}"
             required value="{{ form.tax_number | default('') }}">
    </label>
    <label>
      Назва організації
      <input type="text" name="org_name" maxlength="256"
             value="{{ form.org_name | default('') }}">
    </label>
    <label>
      Назва торгової точки
      <input type="text" name="point_name" maxlength="256"
             value="{{ form.point_name | default('') }}">
    </label>
    <label>
      Адреса торгової точки
      <input type="text" name="point_address" maxlength="256"
             value="{{ form.point_address | default('') }}">
    </label>
    <label>
      Режим
      <select name="fiscal_mode" required>
        <option value="test" {% if form.fiscal_mode == "test" or not form.fiscal_mode %}selected{% endif %}>test</option>
        <option value="prod" {% if form.fiscal_mode == "prod" %}selected{% endif %}>prod</option>
      </select>
    </label>
    <label>
      TSP
      <select name="tsp_enabled">
        <option value="0" {% if form.tsp_enabled != "1" %}selected{% endif %}>Ні</option>
        <option value="1" {% if form.tsp_enabled == "1" %}selected{% endif %}>Так</option>
      </select>
    </label>
    <label>
      Offline дозволений
      <select name="offline_enabled">
        <option value="1" {% if form.offline_enabled != "0" %}selected{% endif %}>Так</option>
        <option value="0" {% if form.offline_enabled == "0" %}selected{% endif %}>Ні</option>
      </select>
    </label>
    <label>
      Offline коди (min)
      <input type="number" name="min_offline_codes" min="0"
             value="{{ form.min_offline_codes | default('0') }}">
    </label>
    <label>
      Offline коди (max)
      <input type="number" name="max_offline_codes" min="0"
             value="{{ form.max_offline_codes | default('0') }}">
    </label>
  </fieldset>

  <fieldset>
    <legend>Перший касир (опціонально)</legend>
    <p class="muted">Залишити порожнім, якщо касири додаватимуться пізніше.</p>
    <label>
      ПІБ касира
      <input type="text" name="operator_name" maxlength="256"
             value="{{ form.operator_name | default('') }}">
    </label>
    <label>
      ІНН касира (10 цифр)
      <input type="text" name="operator_inn" maxlength="10" pattern="[0-9]{10}"
             value="{{ form.operator_inn | default('') }}">
    </label>
    <label>
      Шлях до ключа (.jks / .dat / .pfx / .zs2)
      <input type="text" name="jks_path" maxlength="512"
             value="{{ form.jks_path | default('') }}">
    </label>
    <label>
      Пароль ключа
      <input type="password" name="jks_password" autocomplete="new-password">
    </label>
  </fieldset>

  <div class="form-actions">
    <button type="submit">Зберегти</button>
    <a class="btn-cancel" href="/admin/ui/settings/fns">Скасувати</a>
  </div>
</form>

<script>
(function () {
  const btn = document.getElementById("import_key_btn");
  const statusEl = document.getElementById("import_key_status");
  if (!btn) return;
  btn.addEventListener("click", async () => {
    const fileEl = document.getElementById("import_key_file");
    const pwEl = document.getElementById("import_key_password");
    if (!fileEl.files || fileEl.files.length === 0) {
      statusEl.textContent = "Оберіть файл ключа.";
      return;
    }
    const fd = new FormData();
    fd.append("csrf_token", "{{ csrf_token }}");
    fd.append("password", pwEl.value || "");
    fd.append("key_file", fileEl.files[0]);
    statusEl.textContent = "Читаю ключ…";
    try {
      const resp = await fetch("/admin/ui/settings/fns/parse-key", {
        method: "POST", body: fd,
      });
      const data = await resp.json();
      if (!resp.ok) {
        statusEl.textContent = data.error || "Помилка імпорту.";
        return;
      }
      const form = document.querySelector("form[action='/admin/ui/settings/fns/new']");
      if (data.edrpou) form.elements["tax_number"].value = data.edrpou;
      if (data.org_name) form.elements["org_name"].value = data.org_name;
      if (data.operator_name) form.elements["operator_name"].value = data.operator_name;
      if (data.drfo) form.elements["operator_inn"].value = data.drfo;
      statusEl.textContent = "Заповнено з ключа. Перевірте та збережіть.";
    } catch (e) {
      statusEl.textContent = "Мережева помилка: " + e;
    }
  });
})();
</script>
{% endblock %}
