{% extends "_base.html.j2" %}
{% block title %}Додати касира — Налаштування{% endblock %}
{% block content %}
<h1>Налаштування</h1>
{% include "_settings_tabs.html.j2" %}

<h2>Додати касира до ФН <code>{{ fn }}</code></h2>

{% if errors %}
<div class="alert-error">
  <strong>Помилки:</strong>
  <ul>{% for err in errors %}<li>{{ err }}</li>{% endfor %}</ul>
</div>
{% endif %}

<form method="post"
      action="/admin/ui/settings/fns/{{ fn }}/operators/new"
      autocomplete="off">
  <input type="hidden" name="csrf_token" value="{{ csrf_token }}">

  <fieldset>
    <legend>Дані касира</legend>
    <label>
      ПІБ касира
      <input type="text" name="operator_name" maxlength="256"
             value="{{ form.operator_name | default('') }}">
    </label>
    <label>
      ІНН касира (10 цифр)
      <input type="text" name="operator_inn" maxlength="10" pattern="[0-9]{10}"
             required value="{{ form.operator_inn | default('') }}">
    </label>
    <label>
      Шлях до ключа (.jks / .dat / .pfx / .zs2)
      <input type="text" name="jks_path" maxlength="512"
             required value="{{ form.jks_path | default('') }}">
    </label>
    <label>
      Пароль ключа
      <input type="password" name="jks_password"
             autocomplete="new-password" required>
    </label>
  </fieldset>

  <div class="form-actions">
    <button type="submit">Додати касира</button>
    <a class="btn-cancel" href="/admin/ui/settings/operators">Скасувати</a>
  </div>
</form>
{% endblock %}
