{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/cloud/HubError.schema.json",
  "title": "HubError",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "hub_error_code",
    "retryable",
    "message"
  ],
  "properties": {
    "hub_error_code": {
      "type": "string",
      "enum": [
        "INVALID_SCHEMA_VERSION",
        "DUPLICATE_DOCUMENT",
        "UNKNOWN_FISCAL_NUMBER",
        "PAYLOAD_VALIDATION_FAILED",
        "HUB_INTERNAL_ERROR"
      ]
    },
    "retryable": {
      "type": "boolean"
    },
    "retry_after_seconds": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "message": {
      "type": "string"
    }
  }
}