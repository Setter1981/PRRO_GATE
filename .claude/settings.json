{
  "autoUpdatesChannel": "stable",
  "spinnerTipsEnabled": false,
  "includeGitInstructions": true,
  "defaultMode": "acceptEdits",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./**/secrets/**)",
      "Read(./config/credentials.json)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(docker *)",
      "Bash(kubectl *)",
      "Bash(terraform *)",
      "Bash(alembic upgrade *)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": false,
    "autoAllowBashIfSandboxed": true,
    "excludedCommands": [
      "git",
      "docker",
      "kubectl",
      "terraform"
    ],
    "network": {
      "allowedDomains": [
        "github.com",
        "raw.githubusercontent.com",
        "pypi.org",
        "files.pythonhosted.org",
        "docs.python.org",
        "docs.anthropic.com",
        "code.claude.com",
        "wiki.checkbox.ua"
      ],
      "allowLocalBinding": true
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pre_tool_guard.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/post_edit_note.py",
            "async": true,
            "timeout": 30
          }
        ]
      }
    ]
  }
}
